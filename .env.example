# Copy this file to .env and fill in your own values.
# Never commit or upload the real .env file.

# Yahoo Finance needs no settings.

# Fyers API (free; data APIs need no static IP)
FYERS_APP_ID=
# Regenerate daily through the Fyers login flow.
FYERS_ACCESS_TOKEN=
FYERS_BANKNIFTY_SYMBOL=NSE:NIFTYBANK-INDEX

# Required for the Motilal Oswal live feed
MOTILAL_API_KEY=
MOTILAL_API_SECRET=
MOTILAL_AUTH_TOKEN=
MOTILAL_ACCESS_TOKEN=
MOTILAL_CLIENT_LOCAL_IP=
MOTILAL_CLIENT_PUBLIC_IP=
MOTILAL_MAC_ADDRESS=
# Look this up in Motilal's official index master. Do not guess it.
MOTILAL_BANKNIFTY_INDEX_CODE=

# Optional (defaults shown)
MOTILAL_OS_NAME=Windows
MOTILAL_OS_VERSION=10
MOTILAL_BROWSER_NAME=Chrome
MOTILAL_BROWSER_VERSION=

# Local SQLite file for quote snapshots
ABNTM_DB=abntm_live.db
